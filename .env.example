# Copy this file to ".env" and fill in your own values.
# The launcher (SmartHealth.bat) can also create .env for you from its Settings tab.

# Google Gemini API key, used by the AI advisor and the chatbot.
# Get one for free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Long random string used to sign login sessions.
# Leave empty and the launcher will generate one.
SECRET_KEY=

# Port the web server listens on.
PORT=3535

# Optional: set to "development" to enable Flask debug mode.
# FLASK_ENV=development
